{
  "name": "qwen-architecture-explorer",
  "private": true,
  "version": "1.0.0",
  "description": "Qwen Atlas: an independent, source-backed, zoomable guide to Qwen dense and MoE language models.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/write-build-info.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:data": "vitest run tests/unit/data.test.ts tests/unit/accounting.test.ts"
  },
  "dependencies": {
    "katex": "0.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
